# SPDX-License-Identifier: Apache-2.0
#
# TRI-NET-G1 / TT-Shuttle Squeeze v7 — W15-TT-H AI-EDA Stream
# Vector S-50: Berkeley ABC retime+remap with Trinity-aware cost
#
# Anchor: phi^2 + phi^-2 = 3
# R5 honesty: projection until chip-in-hand 2026-12-16
#
# Gate G-50: post-ABC total gate count <= 0.92 * pre-ABC
#            (5-8% reduction on 16k-gate TT tile target)
#
# Usage (via ABC):
#   abc -f abc_trinity.script
#
# Env vars consumed by run_abc.sh wrapper before invoking ABC:
#   SKY130_HDLL_LIB  — path to sky130_fd_sc_hdll__tt_025C_1v80.lib
#   SKY130_HD_LIB    — path to sky130_fd_sc_hd__tt_025C_1v80.lib
#   ABC_INPUT_AIG    — path to input AIGER file (pre-synthesis)
#   ABC_OUTPUT_BLIF  — path for output BLIF (post-synthesis)
#
# ABC script notation:
#   Commands are standard Berkeley ABC commands.
#   Liberty libs are injected by run_abc.sh via ABC_LIBERTY_HDLL / ABC_LIBERTY_HD
#   env vars; this script reads them as ${ENV:VAR} (ABC 1.01+ syntax).
#
# Trinity-aware cost strategy:
#   - sky130_fd_sc_hdll: higher drive, lower delay — use for CRITICAL cones
#     (timing-sensitive paths near WNS slack limit)
#   - sky130_fd_sc_hd:   standard drive              — use for non-critical cones
#   Two-pass mapping: first pass with hdll constrains critical; second pass
#   with hd picks up the slack on non-critical paths, reducing total gate area.

# ---------------------------------------------------------------------------
# Step 0 — Read input design (AIGER format from Yosys)
# ---------------------------------------------------------------------------
read_aiger ${ABC_INPUT_AIG}

# Print pre-synthesis gate count (captured by run_abc.sh)
print_stats

# ---------------------------------------------------------------------------
# Step 1 — Technology-independent optimisation passes
# ---------------------------------------------------------------------------

# balance: reduce AIG depth (critical-path length) without increasing size
balance

# rewrite -l: algebraic rewriting using 4-input LUT covers
rewrite -l

# rewrite again after balance (DAG-aware)
balance
rewrite -l

# refactor: node collapsing — merges small nodes, reduces fanout-limited delay
refactor -l

# rewrite once more to clean up after refactor
rewrite -l

# final balance
balance

# ---------------------------------------------------------------------------
# Step 2 — Sequential optimisation (retiming)
# ---------------------------------------------------------------------------
# retime -seq: forward/backward retiming moves registers across combinational
# logic to balance pipeline stages and shorten critical path.
# Trinity target: critical path 5 ns -> 4 ns (S-46 + S-50 combined).
retime -seq -M 5

# Post-retime optimisation
balance
rewrite -l

# ---------------------------------------------------------------------------
# Step 3 — Technology mapping pass 1: CRITICAL cones → sky130_fd_sc_hdll
# ---------------------------------------------------------------------------
# Map using the high-drive-low-leakage library for all cells first.
# This constrains timing on the critical cone.
read_lib -w ${ABC_LIBERTY_HDLL}

# map: technology mapping with delay-driven heuristics
map -D 4000 -t

# Post-map cleanup
simplify
rewrite -l

# ---------------------------------------------------------------------------
# Step 4 — Technology mapping pass 2: NON-CRITICAL cones → sky130_fd_sc_hd
# ---------------------------------------------------------------------------
# Switch to standard-drive library and remap non-critical logic.
# Area recovery: hd cells are ~8-12% smaller than hdll on average.
read_lib -w ${ABC_LIBERTY_HD}

# remap non-critical paths (use delay slack from first map pass)
# Cells with positive slack >= 500 ps are candidates for hd replacement.
map -a -t

# ---------------------------------------------------------------------------
# Step 5 — Post-map optimisation
# ---------------------------------------------------------------------------
# phase: phase assignment to reduce inverter count
phase

# simplify: remove redundant logic
simplify

# rewrite once more on the mapped network
rewrite -l

# Final balance over mapped network
balance

# ---------------------------------------------------------------------------
# Step 6 — Verification (internal equivalence check)
# ---------------------------------------------------------------------------
# sec: combinational sequential equivalence check between original AIG
# and current mapped network.  ABC emits "Networks are equivalent." on pass.
sec

# ---------------------------------------------------------------------------
# Step 7 — Statistics and output
# ---------------------------------------------------------------------------
# print_stats reports gate count (captured by run_abc.sh for G-50 check)
print_stats

# write_blif: emit the final mapped BLIF for handoff to OpenROAD place+route
write_blif ${ABC_OUTPUT_BLIF}

# Done — run_abc.sh will parse print_stats output for pre/post delta check
